/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# media-src blob: is load-bearing: dropping in your own video makes an object URL
# for it. connect-src stays 'self' — nothing here calls out, and the demo would
# rather fail visibly than quietly gain a network path.

/vendor/*
  Cache-Control: public, max-age=3600
